---
import { ClientRouter } from 'astro:transitions';
import Seo from '../components/Seo.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { GA_MEASUREMENT_ID } from '../data/site.js';
import '../styles/global.css';

const { title, description, canonical, ogImage, ogType, jsonLd } = Astro.props;

// Production only, so local dev/preview browsing never counts as real
// traffic. import.meta.env.PROD is true for `astro build`, false for `astro
// dev` — set once by Vite, no env var to manage.
const isProd = import.meta.env.PROD;
---
<!doctype html>
<html lang="en">
  <head>
    {isProd && (
      <>
        {/* Google tag (gtag.js). Kept as the first thing in <head>, per
            Google's own placement guidance, and marked is:inline so Astro
            ships it verbatim rather than bundling it. */}
        <script is:inline async src={`https://www.googletagmanager.com/gtag/js?id=${GA_MEASUREMENT_ID}`}></script>
        <script is:inline define:vars={{ GA_MEASUREMENT_ID }}>
          window.dataLayer = window.dataLayer || [];
          function gtag() { window.dataLayer.push(arguments); }
          gtag('js', new Date());
          gtag('config', GA_MEASUREMENT_ID);
        </script>
      </>
    )}
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="theme-color" content="#f1ede5" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Archivo:wdth,wght@62..125,100..900&family=IBM+Plex+Mono:wght@400;500;600&family=Newsreader:ital,opsz,wght@1,6..72,400..600&display=swap"
      rel="stylesheet"
    />
    <Seo
      title={title}
      description={description}
      canonical={canonical}
      ogImage={ogImage}
      ogType={ogType}
      jsonLd={jsonLd}
    />
    <ClientRouter />
  </head>
  <body>
    <Header />
    <main>
      <slot />
    </main>
    <Footer />
  </body>
</html>
