---
import Base from '../layouts/Base.astro';
import ProjectRow from '../components/ProjectRow.astro';
import { projects } from '../data/projects.js';
import { SITE_URL, profilePageJsonLd, projectEntityJsonLd } from '../data/site.js';

// The home page names all three projects, so it also defines them as typed
// entities (software / event / organization) instead of only linking to them.
// A crawler that reads just this one URL then gets the whole model: who he is,
// and what each of the three things actually IS.
const projectEntities = projects.map(projectEntityJsonLd);

const title = 'F. Aamir Ali | Builder & Founder';
// Kept under ~160 characters so Google shows it whole instead of truncating
// mid-sentence in the result that matters most.
const description =
  'Student builder and founder in Surrey, BC. I deployed an AI assistant in my 1,500-student school and co-founded the first youth AI summit in Surrey.';
---
<Base
  title={title}
  description={description}
  canonical="/"
  ogImage="/og/home.png"
  ogType="profile"
  jsonLd={profilePageJsonLd(`${SITE_URL}/`, ...projectEntities)}
>
  <!-- Hero -->
  <section class="hero section">
    <div class="wrap hero-grid">
      <div class="hero-left">
        <div class="hero-eyebrow">
          <span class="dot"></span>
          <span class="eyebrow">Builder &amp; founder · Surrey, BC</span>
        </div>
        <!-- {' '} is a real word space, not decoration: Astro's compiler
             strips the whitespace between adjacent spans, so the markup below
             would otherwise compile to "</span><span" and render (and be read
             aloud by a screen reader) as "AamirAli." An expression survives
             that pass, and unlike a CSS margin it also gives the line a legal
             place to wrap on very narrow screens. -->
        <h1 class="hero-title">
          <span class="t1">Aamir</span>{' '}
          <span class="t2">Ali<span class="accent">.</span></span>
        </h1>
        <p class="hero-line">I turn ideas into real, deployed things that people actually use.</p>
        <div class="hero-cta">
          <a class="btn btn-dark" href="#work">See my work <span aria-hidden="true">→</span></a>
          <a class="btn btn-ghost" href="/about">Read my story</a>
        </div>
      </div>
      <div class="hero-right">
        <div class="headshot">
          <img
            src="/img/aamir.jpg"
            alt="F. Aamir Ali"
            width="1600"
            height="2134"
          />
          <div class="headshot-corner">F.A.A.</div>
        </div>
      </div>
    </div>
  </section>

  <!-- Selected work — the index -->
  <section id="work" class="section">
    <div class="wrap">
      <div class="work-head">
        <div>
          <div class="eyebrow" style="margin-bottom:14px;">Selected work · 2025–2026</div>
          <h2 class="work-title">Built &amp; <span class="serif">shipped.</span></h2>
        </div>
        <p class="work-sub">Real and deployed work, not concepts.</p>
      </div>
      <div class="work-grid">
        {projects.map((p) => <ProjectRow project={p} />)}
      </div>
    </div>
  </section>

  <!-- Recommendation -->
  <section class="rec section">
    <div class="rec-inner">
      <div class="eyebrow rec-eyebrow">Recommendation letter</div>
      <p class="rec-quote serif">“His initiative and technical sophistication are exceptional at the secondary level.”</p>
      <div class="rec-attr"><span class="rec-line"></span>Jodie Perry, Principal, Fleetwood Park Secondary</div>
    </div>
  </section>
</Base>

<style>
  .hero { padding-top: 118px; padding-bottom: 70px; }
  /* The right column is now a FIXED 295px — the photo's capped width — rather
     than a 0.92fr share. Once the photo stopped filling its column, a
     proportional right column just banked whitespace that the masthead needed:
     at 0.92fr the left column was 607px and "AAMIR ALI." on one line measures
     600px, a 7px margin that any font-loading variance would break. Fixed
     right column puts that space back on the left, where it buys ~229px. */
  .hero-grid { display: grid; grid-template-columns: minmax(0, 1fr) 295px; gap: 56px; align-items: center; }
  .hero-eyebrow { display: flex; align-items: center; gap: 10px; margin-bottom: 30px; }

  /* Same card treatment as Placeholder.astro's .ph, but scaled to 1/1.75 of
     the column width and centred: at full width the photo is a ~517px flat,
     evenly lit ID shot, which dominates the hero and reads as a document scan
     rather than a portrait. Smaller lets the masthead lead.

     The max-width still matters below 860px: the grid collapses to one column
     there, so this container becomes the FULL page width and an uncapped 100%
     would render the photo LARGER than on desktop. Capped at the desktop size,
     it can only ever shrink from here. */
  .headshot {
    position: relative; width: 100%; max-width: 295px; margin: 0 auto; aspect-ratio: 4 / 5;
    border-radius: var(--r-card); overflow: hidden; border: 1px solid var(--line);
    box-shadow: 0 22px 50px rgba(26, 24, 19, 0.09);
  }
  .headshot img { width: 100%; height: 100%; object-fit: cover; display: block; }
  .headshot-corner {
    position: absolute; top: 16px; left: 16px; font-family: var(--font-mono);
    font-size: 10.5px; letter-spacing: 0.12em; color: var(--dark-text);
    background: rgba(26, 24, 19, 0.55); padding: 4px 9px; border-radius: var(--r-pill);
  }
  /* Masthead treatment — mixed case, set at display size.
     font-stretch is 100%, NOT the 82% used elsewhere for eyebrows: condensed
     widths exist to stop ALL-CAPS sprawling, and this line is no longer caps.
     At 82% the lowercase came out visibly pinched. Tracking is a touch tighter
     (-0.02em) and leading a touch looser (0.95) than the caps version needed,
     because mixed case brings ascenders the 0.9 line-height had no room for.

     The clamp lives HERE rather than on the two spans because the word space
     between them is a text node of this element: with the size only on the
     spans, that space rendered at the h1's inherited 32px and came out 5px
     wide against 122px letterforms. At the display size the font's own word
     space is 18px and scales with every breakpoint for free. */
  .hero-title { line-height: 0.95; letter-spacing: -0.02em; margin-bottom: 26px; font-stretch: 100%; font-size: clamp(56px, 9vw, 122px); }
  /* inline, not block: the two halves sit on ONE line and the newline between
     the spans in the markup collapses to the word space. They still wrap
     naturally to two lines on narrow viewports, which is what the clamp's
     56px floor is sized for. */
  .hero-title .t1 { display: inline; font-weight: 800; }
  .hero-title .t2 { display: inline; font-weight: 800; }
  /* Was 30ch, which forced this onto two lines to fit the old narrow column.
     With the wider left column it sits on one line under the masthead; the
     cap stays only so it can never outrun a comfortable measure. */
  .hero-line { font-size: clamp(17px, 2vw, 21px); color: var(--muted-2); max-width: 66ch; margin-bottom: 34px; line-height: 1.4; }
  .hero-cta { display: flex; gap: 13px; flex-wrap: wrap; }

  .work-head { display: flex; align-items: flex-end; justify-content: space-between; gap: 24px; flex-wrap: wrap; margin-bottom: 34px; }
  .work-title { font-size: clamp(32px, 4.4vw, 52px); font-weight: 700; letter-spacing: -0.02em; line-height: 1; }
  .work-sub { max-width: 34ch; font-size: 14.5px; color: var(--muted); line-height: 1.5; }
  .work-grid { display: grid; grid-template-columns: repeat(3, 1fr); gap: 18px; align-items: stretch; }

  .rec { padding-top: 90px; padding-bottom: 80px; }
  .rec-inner { max-width: 900px; margin: 0 auto; text-align: center; }
  /* Bigger + bolder than a normal eyebrow — it needs to read clearly as a
     section label ("this is someone else's words") before the quote itself,
     so the pull-quote doesn't land as self-praise. */
  .rec-eyebrow { font-size: 17px; font-weight: 700; letter-spacing: 0.14em; color: var(--ink); margin-bottom: 28px; }
  .rec-quote { font-size: clamp(28px, 4.2vw, 50px); line-height: 1.18; letter-spacing: -0.01em; color: var(--ink); margin-bottom: 26px; }
  .rec-attr { display: inline-flex; align-items: center; gap: 12px; font-family: var(--font-mono); font-size: 12.5px; letter-spacing: 0.05em; text-transform: uppercase; color: var(--muted); }
  .rec-line { width: 26px; height: 1px; background: rgba(28, 26, 20, 0.3); }

  @media (max-width: 860px) {
    .hero-grid { grid-template-columns: 1fr; gap: 36px; }
    .hero-right { max-width: 100%; }
    /* Stacked, this container is the full page width, so the desktop 295px cap
       would let the photo take ~88% of a 375px screen — bigger than it is on
       desktop, and the opposite of the point. Sized down again here. */
    .headshot { width: 60%; max-width: 260px; }
    /* The desktop cap exists to hold a comfortable measure beside the photo —
       once stacked, the column is much wider, so let it use the space. */
    .hero-line { max-width: none; }
    .work-sub { max-width: none; }
    .work-grid { grid-template-columns: repeat(2, 1fr); }
  }
  @media (max-width: 760px) {
    .hero { padding-top: 94px; }
  }
  @media (max-width: 600px) {
    .work-grid { grid-template-columns: 1fr; }
  }
</style>
