---
// The long-form case studies as real, crawlable HTML.
//
// These used to exist only as PDFs. A PDF *is* indexable, but it is a
// second-class result: the snippet is poor, it can't link back into the site,
// it can't carry schema, and no AI-search surface prefers it to an HTML page
// saying the same thing. This page renders the same markdown the PDF is built
// from, through the same module, so the two can never disagree on a fact.
//
// Markdown is parsed at BUILD time and emitted as static HTML — no client-side
// rendering, per the site's hard constraint.
import { marked } from 'marked';
import Base from '../../layouts/Base.astro';
import { caseStudies, renderSource, assertAllApplied } from '../../data/caseStudies.js';
import { getProject } from '../../data/projects.js';
import {
  PERSON_ID,
  SITE_ID,
  SITE_URL,
  breadcrumbJsonLd,
  graph,
  projectEntityJsonLd,
} from '../../data/site.js';

// The markdown is inlined at build time by Vite rather than read with fs at
// render time. Reading from disk here does not work: by the time the page
// renders, the module has been bundled into dist/.prerender/, so a path
// relative to import.meta.url points into the output directory instead of at
// src/. Globbing also means a missing file is a build error, not a 500.
const sources = import.meta.glob('../../content/case-studies/*.md', {
  query: '?raw',
  import: 'default',
  eager: true,
});

export function getStaticPaths() {
  return caseStudies.map((cs) => ({ params: { slug: cs.slug }, props: { cs } }));
}

const { cs } = Astro.props;
const proj = getProject(cs.project);

const raw = sources[`../../content/case-studies/${cs.file}`];
if (!raw) throw new Error(`case study source missing: ${cs.file}`);

// forSite: applies the documented no-negatives edits. assertAllApplied turns a
// rule that no longer matches into a build failure — a silently-skipped rule
// would republish a passage the owner had decided to keep off the site.
const { markdown, applied } = renderSource(raw, cs, { forSite: true });
assertAllApplied(cs, applied, { forSite: true });

// The source's own H1 becomes the page <h1>; the rest is body prose. Splitting
// it here keeps exactly one h1 per page and lets the real title be styled like
// every other page title on the site.
const lines = markdown.split(/\r?\n/);
const h1Index = lines.findIndex((l) => l.startsWith('# '));
const sourceTitle = h1Index >= 0 ? lines[h1Index].replace(/^#\s+/, '') : cs.title;
const body = lines.filter((_, i) => i !== h1Index).join('\n');

// Headings keep their source level. The source's own h1 has already been
// lifted out to become the page <h1>, so its h2s sit directly under it and the
// outline runs h1 -> h2 -> h3 with no skipped level. (Demoting them here
// instead produced h1 -> h3, which is an accessibility and outline defect.)
// Each heading gets a slug id so individual sections are directly linkable —
// deep links are how an AI answer cites one specific passage.
marked.use({
  renderer: {
    heading({ tokens, depth }) {
      const text = this.parser.parseInline(tokens);
      const level = Math.min(depth, 6);
      const id = text
        .replace(/<[^>]+>/g, '')
        .toLowerCase()
        .replace(/[^a-z0-9\s-]/g, '')
        .trim()
        .replace(/\s+/g, '-');
      return `<h${level} id="${id}">${text}</h${level}>\n`;
    },
  },
});
const html = marked.parse(body);

const pageUrl = `${SITE_URL}/case-study/${cs.slug}`;
const title = `${sourceTitle.split(':')[0]} case study | F. Aamir Ali`;

// The project's own entity node is emitted HERE too, not just referenced. An
// @id is a global URI, so a bare cross-page reference is legal JSON-LD — but a
// consumer parsing this page alone would see an untyped dangling pointer. Same
// @id on both pages means one entity described twice, which is the intent.
const entity = proj ? projectEntityJsonLd(proj) : null;

const jsonLd = graph(
  {
    '@type': 'Article',
    '@id': `${pageUrl}#article`,
    headline: sourceTitle,
    description: cs.blurb,
    author: { '@id': PERSON_ID },
    publisher: { '@id': PERSON_ID },
    isPartOf: { '@id': SITE_ID },
    mainEntityOfPage: pageUrl,
    datePublished: cs.published,
    dateModified: cs.updated,
    inLanguage: 'en',
    articleSection: 'Case study',
    // Reads as further detail about a known thing, not a standalone document.
    ...(entity ? { about: { '@id': entity['@id'] } } : {}),
    ...(proj ? { image: `${SITE_URL}${proj.ogImage}` } : {}),
  },
  entity,
  breadcrumbJsonLd([
    { name: 'Home', url: '/' },
    { name: 'Work', url: '/#work' },
    ...(proj ? [{ name: proj.name, url: `/work/${proj.slug}` }] : []),
    { name: 'Case study', url: `/case-study/${cs.slug}` },
  ]),
);
---
<Base
  title={title}
  description={cs.blurb}
  canonical={`/case-study/${cs.slug}`}
  ogImage={proj?.ogImage ?? '/og/default.png'}
  ogType="article"
  jsonLd={jsonLd}
>
  <article class="section">
    <div class="wrap">
      <div class="cs-inner">
        <a class="back" href={`/work/${cs.project}`}>
          <span aria-hidden="true">←</span> Back to {proj?.name ?? 'the project'}
        </a>

        <div class="cs-kicker meta-line">Case study · the full record</div>
        <h1 class="cs-title">{sourceTitle}</h1>

        <div class="cs-actions">
          <a class="btn btn-dark" href={`/pdf/${cs.pdf}`} target="_blank" rel="noopener noreferrer">
            Download as PDF <span aria-hidden="true">→</span>
          </a>
          <a class="btn btn-ghost" href={`/work/${cs.project}`}>See the proof</a>
        </div>

        <!-- Build-time HTML from the source markdown. Static, no client JS. -->
        <div class="cs-prose" set:html={html} />
      </div>
    </div>
  </article>
</Base>

<style>
  .section { padding-top: 118px; }
  /* Long-form prose needs its own narrower column inside the 1180px .wrap —
     dropping it straight into .wrap leaves it hugging the left edge
     (CLAUDE.md §5). */
  .cs-inner { max-width: 820px; margin: 0 auto; }

  .back { display: inline-flex; align-items: center; gap: 8px; font-family: var(--font-mono); font-size: 12.5px; letter-spacing: 0.05em; text-transform: uppercase; color: var(--muted); text-decoration: none; margin-bottom: 30px; transition: color .2s ease; }
  .back:hover { color: var(--accent); }

  .cs-kicker { color: var(--accent); margin-bottom: 16px; }
  .cs-title { font-size: clamp(32px, 4.6vw, 54px); font-weight: 800; letter-spacing: -0.02em; line-height: 1.04; margin-bottom: 26px; }
  .cs-actions { display: flex; gap: 13px; flex-wrap: wrap; padding-bottom: 34px; margin-bottom: 34px; border-bottom: 2px solid var(--ink); }

  /* Prose comes from markdown, so these are descendant selectors rather than
     classes. `:global` is required — Astro's scoped styles can't reach into
     set:html output. */
  .cs-prose :global(p) { font-size: 16.5px; line-height: 1.7; color: var(--muted-2); margin-bottom: 18px; }
  .cs-prose :global(h2) { font-size: clamp(24px, 3vw, 32px); font-weight: 700; letter-spacing: -0.01em; color: var(--ink); margin: 42px 0 14px; padding-top: 26px; border-top: 1px solid var(--line); }
  .cs-prose :global(h3) { font-size: 20px; font-weight: 700; color: var(--ink); margin: 30px 0 10px; }
  .cs-prose :global(h4) { font-size: 17px; font-weight: 700; color: var(--ink); margin: 24px 0 8px; }
  .cs-prose :global(strong) { color: var(--ink); font-weight: 700; }
  .cs-prose :global(em) { font-style: italic; }
  .cs-prose :global(a) { color: var(--accent); text-decoration: underline; text-underline-offset: 2px; }
  .cs-prose :global(ul),
  .cs-prose :global(ol) { margin: 0 0 20px; padding-left: 22px; }
  .cs-prose :global(li) { font-size: 16.5px; line-height: 1.7; color: var(--muted-2); margin-bottom: 8px; }
  .cs-prose :global(li strong:first-child) { color: var(--ink); }
  .cs-prose :global(blockquote) {
    margin: 22px 0; padding: 4px 0 4px 20px; border-left: 3px solid var(--accent);
    font-family: var(--font-serif); font-style: italic; font-size: 19px; color: var(--muted-2);
  }
  .cs-prose :global(hr) { border: none; border-top: 1px solid var(--line); margin: 34px 0; }
  .cs-prose :global(code) { font-family: var(--font-mono); font-size: 14px; background: var(--card); border: 1px solid var(--line); padding: 2px 6px; border-radius: 6px; }
  .cs-prose :global(pre) { background: var(--card); border: 1px solid var(--line); border-radius: var(--r); padding: 18px 20px; overflow-x: auto; margin-bottom: 20px; }
  .cs-prose :global(pre code) { background: none; border: none; padding: 0; }
  /* A wide table must scroll inside itself rather than pushing the page into
     a horizontal scroll. */
  .cs-prose :global(table) { width: 100%; border-collapse: collapse; margin: 20px 0; font-size: 15px; display: block; overflow-x: auto; }
  .cs-prose :global(th),
  .cs-prose :global(td) { border: 1px solid var(--line-2); padding: 9px 12px; text-align: left; vertical-align: top; }
  .cs-prose :global(th) { background: var(--card); font-weight: 700; color: var(--ink); }

  @media (max-width: 760px) {
    .section { padding-top: 94px; }
  }
</style>
