---
import Base from '../../layouts/Base.astro';
import ProofGrid from '../../components/ProofGrid.astro';
import { projects } from '../../data/projects.js';
import { caseStudiesFor } from '../../data/caseStudies.js';
import { publicAssetExists } from '../../data/publicAssets.js';
import {
  PERSON_ID,
  SITE_ID,
  SITE_URL,
  breadcrumbJsonLd,
  graph,
  projectEntityJsonLd,
} from '../../data/site.js';

export function getStaticPaths() {
  return projects.map((p) => ({
    params: { slug: p.slug },
    props: { proj: p, others: projects.filter((x) => x.slug !== p.slug) },
  }));
}

const { proj, others } = Astro.props;

// Drawn only once the file is really on disk, so a not-yet-supplied logo can
// never render as a broken image. Resolved from the project root — see
// src/data/publicAssets.js for why a path relative to this module is unsafe.
const logoReady = publicAssetExists(proj.logo?.src);

const pageUrl = `${SITE_URL}/work/${proj.slug}`;
const studies = caseStudiesFor(proj.slug);

// One @graph per page rather than several loose blocks, so the Article, the
// project's own entity node (SoftwareApplication / Event / Organization) and
// the Person all cross-reference by @id instead of being three unrelated
// guesses. `about` is the link that answers "what is this page about" with an
// entity rather than a string.
const entity = projectEntityJsonLd(proj);
const jsonLd = graph(
  {
    '@type': 'Article',
    '@id': `${pageUrl}#article`,
    headline: proj.name,
    description: proj.seoDescription,
    image: `${SITE_URL}${proj.ogImage}`,
    author: { '@id': PERSON_ID },
    publisher: { '@id': PERSON_ID },
    isPartOf: { '@id': SITE_ID },
    mainEntityOfPage: pageUrl,
    // Explicit dates: an undated page is treated as undated, not as fresh.
    datePublished: proj.published,
    dateModified: proj.updated,
    inLanguage: 'en',
    ...(entity ? { about: { '@id': entity['@id'] } } : {}),
  },
  entity,
  breadcrumbJsonLd([
    { name: 'Home', url: '/' },
    { name: 'Work', url: '/#work' },
    { name: proj.name, url: `/work/${proj.slug}` },
  ]),
);
---
<Base
  title={proj.seoTitle}
  description={proj.seoDescription}
  canonical={`/work/${proj.slug}`}
  ogImage={proj.ogImage}
  ogType="article"
  jsonLd={jsonLd}
>
  <article class="section">
    <div class="wrap">
      <a class="back" href="/#work"><span aria-hidden="true">←</span> Back home</a>

      <!-- The title block leaves a wide empty column on the right, so an
           optional project logo sits there rather than floating centred. -->
      <div class="p-head">
        <div class="p-head-main">
          <!-- File line: factual status metadata, not a status pill -->
          <div class="file-line meta-line">{proj.fileLine}</div>

          <h1 class="p-name">{proj.name}</h1>
          <p class="p-tagline serif">{proj.tagline}</p>
        </div>

        {/* Intrinsic width/height so the box is reserved before the PNG
            arrives — without them this shifts the whole title block on load. */}
        {logoReady && (
          <img
            class="p-logo"
            src={proj.logo.src}
            alt={proj.logo.alt}
            width="2752"
            height="1536"
            loading="eager"
            fetchpriority="high"
          />
        )}
      </div>

      {proj.acts ? (
        <div class="p-acts">
          {proj.acts.map((act) => (
            <section class="act">
              <div class="act-kicker meta-line">{act.kicker}</div>
              <h2 class="act-title">{act.title}</h2>
              {act.paras.map((para) => <p class="p-para">{para}</p>)}
            </section>
          ))}
        </div>
      ) : (
        <div class="p-summary">
          {proj.intro.map((para) => <p class="p-para">{para}</p>)}
        </div>
      )}

      <div class="eyebrow proof-label">The proof</div>
      <ProofGrid proj={proj} />

      {/* The long-form record as real HTML, not only as a PDF. A PDF is
          crawlable but it is a second-class citizen: no internal links out of
          it, weaker snippets, and no way to keep it in the same design. These
          pages are where the depth actually lives for a search engine. */}
      <div class="reads">
        <div class="eyebrow" style="margin-bottom:16px;">The full write-up</div>
        <div class="reads-grid">
          {studies.map((cs) => (
            <a class="read-card" href={`/case-study/${cs.slug}`}>
              <div class="read-kicker meta-line">Case study</div>
              <div class="read-name">{cs.title}</div>
              <p class="read-blurb">{cs.blurb}</p>
              <span class="read-go">Read it <span aria-hidden="true">→</span></span>
            </a>
          ))}
        </div>
      </div>

      <div class="more">
        <div class="eyebrow" style="margin-bottom:16px;">More work</div>
        <div class="more-links">
          {others.map((o) => <a class="more-pill" href={`/work/${o.slug}`}>{o.name}</a>)}
        </div>
      </div>
    </div>
  </article>
</Base>

<style>
  .section { padding-top: 118px; }
  .back { display: inline-flex; align-items: center; gap: 8px; font-family: var(--font-mono); font-size: 12.5px; letter-spacing: 0.05em; text-transform: uppercase; color: var(--muted); text-decoration: none; margin-bottom: 30px; transition: color .2s ease; }
  .back:hover { color: var(--accent); }

  .file-line { color: var(--accent); margin-bottom: 16px; }

  .p-head { display: flex; align-items: flex-start; justify-content: space-between; gap: 36px; }
  .p-head-main { flex: 1 1 auto; min-width: 0; }
  /* Rounded to match every other surface on the site (the raw PNG is a hard
     rectangle) and sized off the viewport so it reads as a real wordmark. */
  .p-logo {
    flex: 0 0 auto; width: clamp(175px, 20vw, 250px); height: auto;
    border-radius: var(--r); margin-top: 4px;
  }

  /* Condensed uppercase at this width closes the word gaps right up
     ("SURREYYOUTHAISUMMIT"), so the spacing is put back explicitly. */
  .p-name {
    font-size: clamp(38px, 6vw, 72px); font-weight: 800; letter-spacing: -0.01em;
    word-spacing: 0.16em; line-height: 0.98; margin-bottom: 16px;
    text-transform: uppercase; font-stretch: 85%;
  }
  .p-tagline { font-size: clamp(20px, 2.6vw, 30px); color: var(--muted-2); max-width: 44ch; line-height: 1.32; margin-bottom: 34px; }

  .p-acts { margin-bottom: 44px; }
  .act { max-width: 64ch; }
  .act + .act { margin-top: 34px; padding-top: 28px; border-top: 1px solid var(--line); }
  .act-kicker { color: var(--accent); margin-bottom: 10px; }
  .act-title { font-size: clamp(22px, 2.8vw, 30px); font-weight: 700; letter-spacing: -0.01em; margin-bottom: 14px; }

  .p-summary { max-width: 64ch; margin-bottom: 44px; }
  .p-para { font-size: 16.5px; line-height: 1.65; color: var(--muted-2); margin-bottom: 16px; }

  .proof-label { margin-bottom: 18px; }

  .reads { margin-top: 44px; padding-top: 28px; border-top: 1px solid var(--line); }
  /* auto-fit, not a fixed count: FleetBot has two case studies and the other
     projects have one, and a lone card must fill the row rather than sit in a
     half-width column with dead space beside it. */
  .reads-grid { display: grid; grid-template-columns: repeat(auto-fit, minmax(280px, 1fr)); gap: 16px; }
  .read-card {
    display: flex; flex-direction: column; align-items: flex-start;
    background: var(--card); border: 1px solid var(--line);
    border-top: 2px solid var(--ink);
    border-radius: var(--r); padding: 26px 26px 22px; text-decoration: none;
    transition: border-color .2s ease, transform .2s ease;
  }
  .read-card:hover { border-color: var(--accent); transform: translateY(-2px); }
  .read-kicker { color: var(--accent); margin-bottom: 12px; }
  /* Fixed two-line box so the blurb and the "Read it" row start at the same
     height across cards whose titles wrap differently (see CLAUDE.md §1). */
  .read-name {
    font-size: 21px; font-weight: 800; letter-spacing: -0.01em; color: var(--ink);
    line-height: 1.15; min-height: calc(1.15em * 2); margin-bottom: 10px;
  }
  .read-blurb { font-size: 14.5px; line-height: 1.55; color: var(--muted-2); margin-bottom: 18px; }
  .read-go {
    margin-top: auto; font-family: var(--font-mono); font-size: 12px;
    letter-spacing: 0.06em; text-transform: uppercase; color: var(--accent); font-weight: 600;
  }

  .more { margin-top: 44px; padding-top: 28px; border-top: 1px solid var(--line); }
  .more-links { display: flex; gap: 12px; flex-wrap: wrap; }
  .more-pill { font-family: var(--font-mono); font-size: 12px; letter-spacing: 0.05em; text-transform: uppercase; color: var(--ink); padding: 12px 20px; border-radius: var(--r-pill); border: 1px solid var(--line-2); background: var(--card); text-decoration: none; transition: border-color .2s ease, color .2s ease; }
  .more-pill:hover { border-color: var(--accent); color: var(--accent); }
  @media (max-width: 760px) {
    .section { padding-top: 94px; }
    /* Reverse so the logo leads the stacked block instead of orphaning
       itself below the tagline. */
    .p-head { flex-direction: column-reverse; align-items: flex-start; gap: 22px; }
    .p-logo { width: 165px; margin-top: 0; }
  }
</style>
